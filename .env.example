# Owner connection: used by migrations, sync and the admin area. Never sent to the browser.
DATABASE_URL=postgres://fb_owner:fb_owner_local@localhost:5432/form_board
# Signed-in people's connection: row-level security limits it to the signed-in person's own submissions.
USER_DATABASE_URL=postgres://web_user:web_user_local@localhost:5432/form_board
# Signs the session cookie. At least 32 random characters; different in every environment.
SESSION_SECRET=replace-with-at-least-32-random-characters
# Comma-separated emails that may use the owner area.
OWNER_EMAILS=owner@example.org
# Development only: shows the "sign in as a test person" switch. Ignored in production.
DEV_SIGNIN=1
# Where sync reads forms from: "fake" (the example forms) or "google" (your real forms).
FORMS_SOURCE=fake
# Your Google approval for reading your forms, and your mail (read-only). See README, "Connect
# Google". Add the gmail.readonly scope too if you want "Forms you applied to" (README).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Where Google sends people back after they sign in. Must match a redirect URI on the client above,
# character for character. Visitors only ever approve "openid email" — never your Forms or Drive.
# Sign-in is offered only when the client, its secret and this URI are all set.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
