# Owner connection: used by migrations, sync and the admin area. Never sent to the browser.
DATABASE_URL=postgres://fb_owner:fb_owner_local@localhost:5432/form_board
# Signed-in people's connection: row-level security limits it to the signed-in person's own submissions.
USER_DATABASE_URL=postgres://web_user:web_user_local@localhost:5432/form_board
