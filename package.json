{
  "name": "form-board",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "db:setup": "bash scripts/setup-local-db.sh",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sync": "node --env-file-if-exists=.env scripts/sync.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "google:check": "node --env-file-if-exists=.env scripts/google-check.ts",
    "gmail:check": "node --env-file-if-exists=.env scripts/gmail-check.ts",
    "gmail:scan": "node --env-file-if-exists=.env scripts/gmail-scan.ts"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "next": "^16.4.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "lighthouse": "^13.5.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
